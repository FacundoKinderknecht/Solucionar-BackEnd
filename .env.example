# ------------------------------------------------------------------
# Solucion.ar Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ------------------------------------------------------------------

# --- Database ---
# PostgreSQL connection string. psycopg (v3) dialect shown below.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- JWT Authentication ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins for production.
# Example: CORS_ORIGINS=https://solucion.ar,https://www.solucion.ar
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Webhook Security (CRITICAL in production) ---
# Used to authenticate callbacks from the payment gateway.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=REPLACE_WITH_A_STRONG_RANDOM_WEBHOOK_SECRET

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
